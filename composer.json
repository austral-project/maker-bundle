{
    "name": "austral/maker-bundle",
    "type": "symfony-bundle",
    "description": "Code generators for Austral: entities, admin modules and project skeleton files. Development only.",
    "keywords": ["austral", "symfony", "bundle", "maker", "generator", "code-generator", "dev"],
    "homepage": "https://austral.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthieu Beurel",
            "email": "matthieu@austral.dev",
            "role": "Developer"
        },
        {
            "name": "Austral contributors",
            "homepage": "https://github.com/austral-project/maker-bundle/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/austral-project/maker-bundle/issues",
        "source": "https://github.com/austral-project/maker-bundle",
        "docs": "https://austral.dev",
        "security": "https://github.com/austral-project/.github/blob/master/SECURITY.md"
    },
    "require": {
        "php": ">=8.4",
        "austral/contracts": "^4.0",
        "austral/tools-bundle": "^4.0",
        "symfony/filesystem": "^7.4",
        "symfony/string": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/maker-bundle": "^1.66"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^7.4"
    },
    "suggest": {
        "austral/entity-bundle": "To generate Austral entities",
        "austral/admin-bundle": "To generate admin modules"
    },
    "autoload": {
        "psr-4": {
            "Austral\\MakerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Austral\\MakerBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    }
}
